xception" detail="&quot;Coluna Valor vazia&quot;" /></stage><stage stageid="ce7640b5-c269-4c3f-8491-45f58f3bf41f" name="Nome preenchido?" type="Decision"><subsheetid>114e3453-1523-4006-8640-4a3044091481</subsheetid><display x="15" y="75" /><decision expression="[Dados do item.Nome] &lt;&gt; &quot;&quot;" /><ontrue>f96a9540-9af6-4468-b77a-8d4c71498f33</ontrue><onfalse>921dcef4-000b-4028-a060-cb6e00db0c22</onfalse></stage><stage stageid="921dcef4-000b-4028-a060-cb6e00db0c22" name="Business Exception" type="Exception"><subsheetid>114e3453-1523-4006-8640-4a3044091481</subsheetid><display x="90" y="75" /><exception localized="yes" type="Business Exception" detail="&quot;Coluna Nome vazia&quot;" /></stage><stage stageid="f96a9540-9af6-4468-b77a-8d4c71498f33" name="Telefone preenchido?" type="Decision"><subsheetid>114e3453-1523-4006-8640-4a3044091481</subsheetid><display x="15" y="120" /><decision expression="[Dados do item.Telefone] &lt;&gt; &quot;&quot;" /><ontrue>47eaa13f-d5cc-45f3-9089-9f46a4b1f23e</ontrue><onfalse>b4a2f618-1098-40d3-b8bc-feb238eae223</onfalse></stage><stage stageid="b4a2f618-1098-40d3-b8bc-feb238eae223" name="Business Exception" type="Exception"><subsheetid>114e3453-1523-4006-8640-4a3044091481</subsheetid><display x="90" y="120" /><exception localized="yes" type="Business Exception" detail="&quot;Coluna Telefone vazia&quot;" /></stage><stage stageid="47eaa13f-d5cc-45f3-9089-9f46a4b1f23e" name="CPF/CNPJ preenchido?" type="Decision"><subsheetid>114e3453-1523-4006-8640-4a3044091481</subsheetid><display x="15" y="165" /><decision expression="[Dados do item.CPF/CNPJ] &lt;&gt; &quot;&quot;" /><ontrue>ad6b75bb-6874-4765-86e8-e9fc4b4335f7</ontrue><onfalse>95b0de19-9879-4117-944a-6b5f1f91219a</onfalse></stage><stage stageid="95b0de19-9879-4117-944a-6b5f1f91219a" name="Business Exception" type="Exception"><subsheetid>114e3453-1523-4006-8640-4a3044091481</subsheetid><display x="90" y="165" /><exception localized="yes" type="Business Exception" detail="&quot;Colu