]]></code></stage><stage stageid="17b01461-dbce-4c58-9d8b-e07d39140075" name="Handle" type="Data"><subsheetid>8bf9be03-0eb7-4a7b-9288-4701615470f7</subsheetid><display x="-120" y="-45" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c00c8ae5-9269-4cb6-9d56-bd7529add0d3" name="Workbook" type="Data"><subsheetid>8bf9be03-0eb7-4a7b-9288-4701615470f7</subsheetid><display x="-120" y="-15" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="56c4d0fb-7039-41d3-ae6d-44bd15a90770" name="Start" type="Start"><subsheetid>8bf9be03-0eb7-4a7b-9288-4701615470f7</subsheetid><loginhibit /><display x="60" y="-120" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="Handle" narrative="Unique handle to a specific Excel instance." stage="Handle" /><input type="text" name="Workbook" narrative="The name of the specific workbook." stage="Workbook" /></inputs><onsuccess>ff58ebec-40ad-448e-83aa-a857c3d5c3e8</onsuccess></stage><stage stageid="2542a814-db9f-4f1d-8455-fb713072a319" name="Input" type="Block"><subsheetid>8bf9be03-0eb7-4a7b-9288-4701615470f7</subsheetid><loginhibit /><display x="-195" y="-75" w="150" h="90" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="a9b2d2a9-3659-491d-ab90-d70e9e605365" name="Output" type="Block"><subsheetid>8bf9be03-0eb7-4a7b-9288-4701615470f7</subsheetid><loginhibit /><display x="-195" y="30" w="150" h="60" /><font family="Segoe UI" size="10" style="Regular" color="FFCC99" /></stage><stage stageid="18acf1bb-bb3c-460f-b571-55f5f14343b1" name="Local Data" type="Block"><subsheetid>8bf9be03-0eb7-4a7b-9288-4701615470f7</subsheetid><loginhibit /><display x="-195" y="105" w="150" h="60" /><font family="Segoe UI" size="10" style="Re