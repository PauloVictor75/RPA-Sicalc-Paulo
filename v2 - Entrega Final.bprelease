ListaPDF = String.Join(";", arquivosPDF)]]></code></stage><stage stageid="7132b2f8-df7b-48d7-b56e-b8b5adcc0894" name="ListaPDF" type="Data"><subsheetid>17f7b996-5341-4c24-8984-b50cac99b769</subsheetid><display x="105" y="-15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="184ade7e-65c8-4c29-9b77-6c3eae2d41ab" name="SicalcAA_Saida" type="Data"><subsheetid>17f7b996-5341-4c24-8984-b50cac99b769</subsheetid><loginhibit /><display x="120" y="-90" /><datatype>text</datatype><initialvalue /><exposure>Environment</exposure><private /><alwaysinit /></stage><stage stageid="78df705a-b6cb-4aeb-b4ee-fb6046bd2c64" name="Send Email" type="Action"><subsheetid>17f7b996-5341-4c24-8984-b50cac99b769</subsheetid><loginhibit onsuccess="true" /><display x="15" y="90" /><inputs><input type="text" name="To" friendlyname="To" narrative="Mandatory. Any alphanumeric value allowed. Single Recipient = &quot;Name1@emaill.com&quot;; Multi Recipient = &quot;Name1@emaill.com; Name2@email.com&quot;" expr="[SicalcAA_EMAIL]" /><input type="text" name="CC" friendlyname="CC" narrative="Optional. Any alphanumeric value allowed. Single Recipient = &quot;Name1@emaill.com&quot;; Multi Recipient = &quot;Name1@emaill.com; Name2@email.com&quot;. Default blank" expr="" /><input type="text" name="BCC" friendlyname="BCC" narrative="Optional. Any alphanumeric value allowed. Single Recipient = &quot;Name1@emaill.com&quot;; Multi Recipient = &quot;Name1@emaill.com; Name2@email.com&quot;. Default blank" expr="" /><input type="text" name="Subject" friendlyname="Subject" narrative="Optional. Any alphanumeric value allowed." expr="&quot;RPA Sicalc - Processamento Concluído&quot;" /><input type="text" name="Message" friendlyname="Message" narrative="Optional, HTML or plain text" expr="&quot;&lt;html&gt;&#xA;&lt;body style='margin:0;padding:0;background-color:#f4f6f8;font-family:Segoe UI,Arial,sans-serif;color:#333333;'&gt;&#xA;&#xA;&lt;table width='100%' cellpadding='0' cellspacing='0' border='0'&gt;&#xA;&lt;tr&gt;&#xA;&lt;td align='center' style='padding:30px 15px;'&gt;&#xA;&#xA;&lt;table width='650' cellpadding='0' cellspacing='0' border='0'&#xA;style='background-color:#ffffff;border:1px solid #e0e0e0;'&gt;&#xA;&#xA;&lt;tr&gt;&#xA;&lt;td style='background-color:#1F4E78;padding:22px 30px;color:#ffffff;'&gt;&#xA;&lt;div style='font-size:22px;font-weight:bold;'&gt;&#xA;RPA Sicalc&#xA;&lt;/div&gt;&#xA;&lt;div style='font-size:13px;margin-top:5px;'&gt;&#xA;Processamento concluído&#xA;&lt;/div&gt;&#xA;&lt;/td&gt;&#xA;&lt;/tr&gt;&#xA;&#xA;&lt;tr&gt;&#xA;&lt;td style='padding:30px;'&gt;&#xA;&#xA;&lt;h2 style='margin-top:0;color:#1F4E78;font-size:20px;'&gt;&#xA;Processamento Concluído&#xA;&lt;/h2&gt;&#xA;&#xA;&lt;p style='font-size:14px;line-height:1.6;'&gt;&#xA;Prezados,&#xA;&lt;/p&gt;&#xA;&#xA;&lt;p style='font-size:14px;line-height:1.6;'&gt;&#xA;Informamos que o &lt;b&gt;processamento do RPA Sicalc&lt;/b&gt;&#xA;foi concluído com sucesso.&#xA;&lt;/p&gt;&#xA;&#xA;&lt;p style='font-size:14px;line-height:1.6;'&gt;&#xA;Os documentos gerados pelo processo estão anexados a este&#xA; e-mail para conferência e utilização.&#xA;&lt;/p&gt;&#xA;&#xA;&lt;p style='font-size:14px;line-height:1.6;margin-top:30px;'&gt;&#xA;Atenciosamente,&lt;br&gt;&#xA;&lt;b&gt;RPA Sicalc&lt;/b&gt;&lt;br&gt;&#xA;&lt;span style='color:#666666;'&gt;&#xA;Automação de Processos&#xA;&lt;/span&gt;&#xA;&lt;/p&gt;&#xA;&#xA;&lt;/td&gt;&#xA;&lt;/tr&gt;&#xA;&#xA;&lt;tr&gt;&#xA;&lt;td style='background-color:#f1f3f5;padding:18px 30px;border-top:1px solid #e0e0e0;'&gt;&#xA;&lt;p style='margin:0;font-size:11px;color:#777777;text-align:center;'&gt;&#xA;Este e-mail foi enviado automaticamente pelo RPA Sicalc.&lt;br&gt;&#xA;Por favor, não responda a esta mensagem.&#xA;&lt;/p&gt;&#xA;&lt;/td&gt;&#xA;&lt;/tr&gt;&#xA;&#xA;&lt;/table&gt;&#xA;&#xA;&lt;/td&gt;&#xA;&lt;/tr&gt;&#xA;&lt;/table&gt;&#xA;&#xA;&lt;/body&gt;&#xA;&lt;/html&gt;&quot;" /><input type="text" name="Attachments" friendlyname="Attachments" narrative="Optional, Semicolon--separated file paths. Default blank." expr="[ListaPDF]" /><input type="flag" name="IsHTML" friendlyname="IsHTML" narrative="Optional. True or False, default to True" expr="True" /><input type="number" name="Sensitivity" friendlyname="Sensitivity" narrative="Optional. An integer between 0 and 3, default to 0." expr="" /><input type="number" name="Importance" friendlyname="Importance" narrative="Optional. An integer between 0 and 2 default to 1." expr="" /><input type="text" name="Account Display Name" friendlyname="Account Display Name" narrative="Optional. DisplayName of the email account. Default account is used if omitted." expr="" /><input type="text" name="Shared Mailbox" friendlyname="Shared Mailbox" narrative="Optional. Share Mailbox name or email address. Attempt to call Shared Mailbox is only initiated when a value is supplied." expr="" /><input type="text" name="Voting Options" friendlyname="Voting Options" narrative="Optional: A semicolon-delimited list of values. Example: “Cheese; Mushroom; Sausage; Combo; Veg Combo;”. " expr="" /><input type="text" name="Vote Recipients" friendlyname="Vote Recipients" narrative="Optional: A semicolon-delimited list of email addresses that should receive the results of any votes." expr="" /><input type="text" name="MIP Label GUID" friendlyname="MIP Label GUID" narrative="Optional: The unique identifier associated with an MIP sensitivity label within your organization." expr="" /><input type="text" name="Tenant ID" friendlyname="Tenant ID" narrative="Optional: Required when sending mail with an MIP sensitivity label." expr="" /></inputs><onsuccess>d2295bb0-e921-497f-b656-c6ea1982b061</onsuccess><resource object="MS Outlook Email VBO" action="Send Email" /></stage><stage stageid="cef11f6f-d0a2-4778-bea8-3ee27e758f91" name="SicalcAA_EMAIL" type="Data"><subsheetid>17f7b996-5341-4c24-8984-b50cac99b769</subsheetid><loginhibit /><display x="105" y="60" /><datatype>text</datatype><initialvalue /><exposure>Environment</exposure><alwaysinit /></stage></process></object>
