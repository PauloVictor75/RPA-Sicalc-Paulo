  <stage stageid="0c46c352-79de-438b-9ce3-422dcc0fb10b" name="Filter Expression" type="Calculation">
    <subsheetid>7aafcecd-5e8f-49d4-9987-73958f3cedc3</subsheetid>
    <loginhibit />
    <display x="90" y="180" />
    <onsuccess>a3d2888f-df21-47e3-8405-7f6f4564a71b</onsuccess>
    <calculation expression="[Filter Expression]&amp;&quot; AND urn:schemas:httpmail:textdescription LIKE '&quot;&amp;Replace([Message], &quot;*&quot;, &quot;%&quot;)&amp;&quot;'&quot;" stage="Filter Expression" />
  </stage>
