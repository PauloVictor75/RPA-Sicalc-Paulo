  <stage stageid="c36190da-7569-4737-a401-bec5b006c53f" name="Start" type="Start">
    <subsheetid>e0b58522-643b-42ad-8fdd-4cb5246c5558</subsheetid>
    <loginhibit />
    <display x="15" y="-105" />
    <inputs>
