  <stage stageid="b5542c2e-3ef3-4636-82e6-10fcb6b9f5ef" name="Entry ID" type="Data">
    <subsheetid>9bf4e24d-5759-4357-97f1-adc1c08c843a</subsheetid>
    <narrative>An ID obtained from one of the Get Item actions in this object.</narrative>
    <display x="-195" y="195" w="150" h="30" />
