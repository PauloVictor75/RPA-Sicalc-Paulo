  <stage stageid="0a43914c-9616-4339-82c1-d0881b0e6f78" name="Assign Categories to Email" type="Code">
    <subsheetid>c3f6b9ae-7abb-4efc-bd43-6c77dd197e37</subsheetid>
    <loginhibit />
    <display x="15" y="-15" w="150" h="30" />
    <inputs>
      <input type="text" name="Entry ID" expr="[Entry ID]" />
      <input type="text" name="Categories" expr="[Categories]" />
    </inputs>
    <outputs>
      <output type="text" name="ExceptionMessage" stage="ExceptionMessage" />
    </outputs>
    <onsuccess>499eaca0-4ae6-4001-9bf2-5b042aa37326</onsuccess>
    <code><![CDATA[ExceptionMessage = "No Exception Reported"

Dim olApp As New NetOffice.OutlookApi.Application
Dim olNamespace As NetOffice.OutlookApi._NameSpace = olApp.GetNamespace("MAPI")

Try
	Dim mailItem = olNamespace.GetItemFromID(Entry_ID)
	mailItem.Categories = Categories
	mailItem.Save
Catch ex As System.Exception
	' Build one string with all messages
	ExceptionMessage = String.Join(Environment.NewLine, GetAllExceptions(ex).Select(Function(e) e.Message).ToArray())

Finally
	olNamespace = Nothing
	olApp = Nothing
End Try]]></code>
  </stage>
