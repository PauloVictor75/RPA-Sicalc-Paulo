  <stage stageid="d227da32-a9f6-47b4-96b0-f961439b32ea" name="Get Items in Folder" type="SubSheetInfo">
    <subsheetid>7756da40-e4db-4cf5-a679-a1c186117e01</subsheetid>
    <narrative>General purpose action that can be used to retrieve mail items from any Outlook folder (ex. Inbox, Sent Items, bespoke folder, etc).</narrative>
    <display x="-225" y="-105" w="210" h="90" />
  </stage>
  <stage stageid="2ff658d9-0062-478a-b3fa-f42e039c0454" name="End" type="End">
    <subsheetid>7756da40-e4db-4cf5-a679-a1c186117e01</subsheetid>
